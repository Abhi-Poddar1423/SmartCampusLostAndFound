# Compiled class files & build output
bin/
out/
*.class

# Scratch & temporary development test scripts
scratch/

# Configuration with local credentials (keep local, never commit)
config/db.properties

# User-uploaded item photos and personal data
uploads/*
!uploads/items/
!uploads/.gitkeep
uploads/items/*
!uploads/items/.gitkeep

# Database backups, SQL dumps, and data exports (allow sql/ migration scripts)
*.sql
!sql/*.sql
*.dump
backups/

# Logs, crash dumps, and temporary files
*.log
*.tmp
hs_err_pid*
replay_pid*
*.hprof

# IDE and editor settings
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
*.sublime-project
*.sublime-workspace

# OS-generated metadata
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.DS_Store
.Spotlight-V100
.Trashes
